# Diese Datei ist nur die Vorlage. start.sh erzeugt backend/.env automatisch,
# setzt sichere Zufallswerte und schützt die Datei mit Modus 600.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=it_tabelander
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_OPERATION_TIMEOUT_MS=5000

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=CHANGE_ME@example.invalid
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD

# Nur Fallbacks für den allerersten Seed. Danach im Online-Admin unter
# Einstellungen pflegen.
CANONICAL_BASE_URL=https://it.tabelander.co.at
CORS_ORIGINS=https://it.tabelander.co.at

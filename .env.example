# SMTP remains disabled until this is explicitly enabled and every required
# SMTP value is available. Never commit a populated .env file.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=mailer@example.test
SMTP_PASSWORD_FILE=/run/secrets/it-tabelander-smtp-password
SMTP_ALLOW_SELF_SIGNED=false
SMTP_VERIFY_PEER=true
SMTP_VERIFY_PEER_NAME=true
SMTP_EHLO_DOMAIN=website.example.test

CONTACT_RECIPIENT=office@example.test
CANONICAL_BASE_URL=https://www.example.test
RUNTIME_LOG_RETENTION_DAYS=30

# Optional integrations. Leave empty to keep them disabled.
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY_FILE=/run/secrets/it-tabelander-google-places-api-key

# Dolibarr creates draft proposals only. The API key belongs in a protected
# file outside the website document root.
DOLIBARR_ENABLED=false
DOLIBARR_BASE_URL=https://erp.example.test
DOLIBARR_API_KEY_FILE=/var/www/it-tabelander-secrets/dolibarr-api-key.txt
DOLIBARR_ENTITY=0
DOLIBARR_VAT_RATE=
DOLIBARR_COUNTRY_CODE=AT
DOLIBARR_TIMEOUT_SECONDS=8

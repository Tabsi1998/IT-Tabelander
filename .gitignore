# ── Secrets & lokale Umgebungsdateien ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.credentials
deploy.config.local

# ── Python / Backend ─────────────────────────────────────────────────────
backend/venv/
backend/uploads/*
!backend/uploads/.gitkeep
__pycache__/
*.pyc
.pytest_cache/
backend/pytest-*/

# ── Node / Frontend ──────────────────────────────────────────────────────
# frontend/ held the old admin until milestone 4 (#57). A server updated
# from then keeps these leftovers until start.sh removes them; ignored, so
# ./update.sh does not stop at "Lokale Änderungen".
frontend/node_modules/
frontend/build/
frontend/.build.*/
frontend/.yarn/
web/build/
web/node_modules/
web/dist/
web/dist-ssr/
web/test-results/
web/playwright-report/
web/screenshots/

# ── Laufzeit (von start.sh erzeugt) ──────────────────────────────────────
run/
logs/

# ── Tooling-Rauschen ─────────────────────────────────────────────────────
.gitconfig
auth_testing.md
design_guidelines.json
memory/
test_reports/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.env

# Local VS Code test environments and generated results
/.local-testing/
/*.code-workspace
.venv/

# ── IT-Tabelander Deployment-Konfiguration ───────────────────────────────
# Wird von start.sh / stop.sh / update.sh eingelesen. Werte hier anpassen.

# Öffentliche URL, unter der die Seite erreichbar ist (für den Frontend-Build).
# Muss dieselbe Origin sein, unter der auch /api erreichbar ist.
PUBLIC_BACKEND_URL="https://it.tabelander.co.at"

# Interne Ports (hinter Apache/Reverse-Proxy)
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8001"
FRONTEND_PORT="3000"

# Uvicorn-Worker fürs Backend
BACKEND_WORKERS="2"

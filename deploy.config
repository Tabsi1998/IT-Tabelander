# ── IT-Tabelander Deployment-Konfiguration ───────────────────────────────
# Wird von start.sh / stop.sh / update.sh eingelesen. Werte hier anpassen.

# Ein Port für Website und /api. 0.0.0.0 macht ihn für einen Reverse Proxy
# auf einem anderen LAN-Gerät bzw. in einem Container über die Server-IP erreichbar.
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8001"

# Nur diesen Proxys werden X-Forwarded-For/-Proto-Header geglaubt. Läuft der
# Reverse Proxy auf einem anderen LAN-Gerät, dessen IP in deploy.config.local
# eintragen, z. B. FORWARDED_ALLOW_IPS="127.0.0.1,192.168.2.20".
FORWARDED_ALLOW_IPS="127.0.0.1"

# Interpreter und Startprüfung. Unterstützt werden Python 3.10 bis 3.14.
PYTHON_BIN="python3"
STARTUP_TIMEOUT_SECONDS="30"

# Die Seeds laufen beim Prozessstart. Bis sie vollständig atomar sind, bleibt
# die Worker-Zahl bewusst auf 1, damit beim Erststart keine Duplikate entstehen.
BACKEND_WORKERS="1"
